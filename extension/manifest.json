{
  "manifest_version": 3,
  "name": "CobraDeals — Find Cheaper",
  "version": "2.0.0",
  "description": "Automatically find cheaper prices across the web. Works on any product page.",
  "permissions": ["activeTab", "storage"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "css": ["panel.css"]
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "CobraDeals"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
